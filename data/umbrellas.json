    {
      "id": "luzhou-fenshui",
      "name": "泸州分水油纸伞",
      "alias": "",
      "origin": "",
      "geometry": {
        "ribCount": 24,
        "radius": 1.0,
        "apexHeight": 0.55,
        "canopyRise": 0,
        "ribRadius": 0.013,
        "strutRadius": 0.010,
        "ribLength": 60,
        "openAmount": 1,
        "shaftLength": 95
      },
      "material": {
        "canopyTexture": "",
        "canopyColor": "#e9c97e",
        "transmission": 0.85,
        "roughness": 0.5,
        "ribColor": "#765c14"
      },
      "light": {
        "azimuth": 195,
        "intensity": 2.6
      },
      "culture": {
        "shape": {
          "name": "形制特征",
          "text": "以楠竹为骨、手工皮纸为面、外涂桐油，可开合，伞身轻便美观。",
          "level": "史实",
          "_source": "http://xinhuanet.com.cn/culture/20250217/1dce2fd1d61745a185fc6c38e5e0ace9/c.html"
        },
        "size": {
          "name": "典型尺寸",
          "text": "常见成品伞面直径约 84 厘米或 100 厘米。",
          "level": "史实",
          "_source": "http://www.wenlvw.cn/index.php?m=content&c=index&a=show&catid=9&id=4024"
        },
        "materials": {
          "name": "主要用材",
          "text": "以泸州本地盛产的桐油、楠竹、皮纸等为主要原料。",
          "level": "史实",
          "_source": "http://xinhuanet.com.cn/culture/20250217/1dce2fd1d61745a185fc6c38e5e0ace9/c.html"
        },
        "patternTheme": {
          "name": "纹样主题",
          "text": "伞面以传统石印工艺印制诗画纹样，诗画兼备。",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        "patternMeaning": {
          "name": "纹样寓意",
          "text": "",
          "level": "",
          "_source": null
        }
      },
      "craftSteps": [
        {
          "name": "选竹",
          "desc": "挑选竹身挺直、竹节均匀、没有虫蛀霉变的成熟楠竹。竹料是整把伞的底子，选得不好，伞骨容易断、容易变形，后面工序再用心也难补救。",
          "image": "assets/craft/craft-01.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "制骨",
          "desc": "把竹料剖成细条，再一步步削、磨成粗细均匀的伞骨。骨条粗细不一，伞面撑开后就会歪斜不平；削得均匀，伞形才周正，开合才顺滑。",
          "image": "assets/craft/craft-02.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "装架",
          "desc": "在伞骨上钻好孔，装进上巢、下巢，再套到中棒上，让骨条能绕中棒开合。孔位或巢位对不齐，伞一开骨条就互相卡住，整把伞就废了。",
          "image": "assets/craft/craft-03.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "满穿",
          "desc": "用线在伞骨之间一圈圈穿绕，把整副骨架连成一体。满穿能拉住每一根骨条、让伞面受力均匀；穿得松或漏穿，伞面会塌，也容易被风吹翻。",
          "image": "assets/craft/craft-04.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "裱面",
          "desc": "把手工皮纸按伞面裁好，一张张糊到伞骨上，拼成完整的伞面。糊得不平、留气泡或接缝不严，上油后就会起皱漏水，伞就挡不住雨了。",
          "image": "assets/craft/craft-05.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "石印",
          "desc": "用传统的石印手艺在伞面上印出图案花纹，让素面变成有纹样的伞面。这道工序要把图案印得位置正、纹路清晰；印偏或印糊了，整面伞面就花了，只能揭掉纸重新来过。",
          "image": "assets/craft/craft-06.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "上油",
          "desc": "在伞面上一遍遍刷桐油，让纸吃透油、变得防水耐用。油刷不匀或没刷透，伞面会渗水、发脆；刷匀了，伞面才经得起雨淋日晒。",
          "image": "assets/craft/craft-07.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        },
        {
          "name": "成伞",
          "desc": "把上好油的伞撑开晾干，让桐油干透定型，再收边、装上手柄，一把伞才算完成。没晾干就收，伞面会粘连、变形，前面的功夫就白费了。",
          "image": "assets/craft/craft-08.png",
          "level": "史实",
          "_source": "https://www.ihchina.cn/art/detail/id/11476.html"
        }
      ]
    },
    {
      "id": "hangzhou-yuhang",
      "name": "余杭油纸伞",
      "alias": "余杭纸伞",
      "origin": "浙江省杭州市余杭区瓶窑镇（塘埠村、西坞村一带）",
      "geometry": {
        "ribCount": 36,
        "radius": 1.0,
        "apexHeight": 0.55,
        "canopyRise": 0,
        "ribRadius": 0.013,
        "strutRadius": 0.010,
